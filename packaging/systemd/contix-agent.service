# CONTIX agent (ADR-177): jen čte stav serveru a posílá podepsané zprávy koncentrátoru zóny.
# Nepřijímá žádné příkazy. Běží jako root jen kvůli čtení (cizí ~/.ssh, procesy, firewall), ale bez
# práv k zápisu do systému: souborový systém jen pro čtení kromě /var/lib/contix-agent-host.
[Unit]
Description=CONTIX agent (read-only host state -> zone concentrator)
Documentation=https://github.com/dynamicdata-cz/contix-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/contix-agent agent run --state-dir /var/lib/contix-agent-host
Restart=on-failure
RestartSec=10
UMask=0077
Nice=10
IOSchedulingClass=idle
MemoryMax=256M
CPUQuota=20%

# jen potřebná oprávnění ke čtení: cizí soubory (~/.ssh), sokety procesů, pravidla firewallu
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/contix-agent-host
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
